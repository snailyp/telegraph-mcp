# Copy to .env and fill in real values. Never commit .env.

# The shared secret MCP clients present to call this server.
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# The Telegraph account's access token; determines which account published
# pages belong to. Obtain one with: telegraph-mcp bootstrap
TELEGRAPH_ACCESS_TOKEN=

# Optional author byline applied to published pages. Leave commented out to use
# the defaults (no author name; author link https://telegra.ph).
# TELEGRAPH_AUTHOR_NAME=
# TELEGRAPH_AUTHOR_URL=

# Server binding. Defaults to localhost so exposing the server is deliberate.
HOST=127.0.0.1
PORT=8000
MCP_PATH=/mcp